{
    "$schema": "./node_modules/wrangler/config-schema.json",

    "name": "slugger-online",
    "compatibility_date": "2026-11-01",

    // The site answers on slugger.online and nowhere else.
    //
    // Left at its default, this Worker also answers on
    // slugger-online.<subdomain>.workers.dev — the same bytes under a second hostname,
    // which search engines index, visitors bookmark and links point at, none of it
    // intended. Turning it off is the only way to make the custom domain the site's
    // address rather than one of its addresses.
    //
    // The cost is real: a first deployment then has no hostname at all until the domain is
    // attached. It does NOT govern preview URLs, which are controlled separately.
    "workers_dev": false,

    // THERE IS A SCRIPT NOW, and §12.3 asks that putting one here be a decision rather than
    // something discovered in a diff. This is the decision.
    //
    // What that section said, and why it was right to say it: requests served as static
    // assets are free and unmetered, requests that invoke a Worker script count against the
    // plan's request quota, and exhausting that quota answers an error rather than falling
    // back to the assets. The difference between a script and no script was the difference
    // between a site that degrades and a site that goes down.
    //
    // What changed is not the appetite for a script, it is what one costs when it is kept
    // OFF THE PATH. A request matching a static asset is served from the asset store without
    // invoking the script; a request matching none is answered by "not_found_handling", also
    // without invoking it. Only the paths named in "run_worker_first" reach the script at
    // all. So the quota this script can exhaust is its own, and exhausting it stops the
    // measurement — not a page, not an asset, not the 404.
    //
    // That confinement is the whole basis of the decision. Widening "run_worker_first", or
    // dropping it, puts the site back in front of the quota and is not a change to make
    // without reopening §12.3.
    //
    // The other case that will tempt a script is still shareable playground URLs, and the
    // answer there is still no (§10.7): encoding the state in the URL fragment costs nothing
    // on the server, and a theme the visitor opened is not shareable at all because §10.6
    // refuses to transmit it.
    "main": "worker/index.ts",

    // Where the dimensioned events land (§15.2). A data point here is one visitor copying
    // one install command, or one theme author trying a file — never anything of the file.
    "analytics_engine_datasets": [
        {
            "binding": "MEASUREMENT",
            "dataset": "slugger_measurement"
        }
    ],

    "assets": {
        "directory": "./dist/",

        // THE ONE PATH THAT REACHES THE SCRIPT. Everything absent from this list keeps the
        // asset-first behaviour described above, which is what makes the script unable to
        // affect the site. An exact path, not a glob: the collector answers on one address
        // and has no second one to grow into.
        "run_worker_first": ["/_event"],

        // "404-page" serves the nearest 404.html for a request matching no asset.
        //
        // Not "single-page-application": this site is many pages, and that mode would
        // answer 200 with the home page for every mistyped URL — invisible to a visitor and
        // poison to a search engine. The playground is the one part that needs a shell
        // fallback, and it gets it from the rewrites in _redirects rather than from a mode
        // that would apply site-wide.
        "not_found_handling": "404-page"
    }
}
