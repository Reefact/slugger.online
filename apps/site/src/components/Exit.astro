---
import { packages, stateWording } from '../metadata';
import type { Placement } from '../measurement';

interface Props {
    /** What the visitor has just understood — never more (§9.3). */
    lead: string;
    /** Which package ids this exit offers, in order. A graded exit offers what was shown. */
    offers: readonly string[];
    /** The moment this exit sits at, named for what was understood (§15.2). */
    placement: Placement;
    extra?: { readonly href: string; readonly label: string };
}

const { lead, offers, placement, extra } = Astro.props;
const shown = packages.filter((pkg) => offers.includes(pkg.id));
---

<!--
  §9.3 — every act ends with an exit, and the exits are GRADED. A visitor convinced at the
  end of act one has no reason to read on, and the page has to let them leave with the
  command in hand. An exit that offers what they have not been shown yet is noise.
-->
<aside class="exit" aria-label="Install">
    <p class="prose">{lead}</p>
    <dl class="install">
        {
            shown.map((pkg) => (
                <div>
                    <dt>
                        {pkg.label} &middot; {pkg.id} {pkg.version}
                    </dt>
                    <dd>
                        {pkg.state === 'published' ? (
                            <div class="command-row">
                                {/*
                                  The command is readable and selectable with no script. The
                                  copy button is ADDED only where the clipboard works, because
                                  §5.7 refuses anything visible that leads nowhere.

                                  The placement says which moment convinced them, and the
                                  variant which half they took — the engine and the command do
                                  not say the same thing about a reader (§15.2).
                                */}
                                <code
                                    class="slot-command"
                                    data-command
                                    data-placement={placement}
                                    data-variant={pkg.id}
                                >
                                    {pkg.command}
                                </code>
                            </div>
                        ) : (
                            <p class="state">{stateWording[pkg.state]}</p>
                        )}
                    </dd>
                </div>
            ))
        }
    </dl>
    {extra && <p class="prose"><a href={extra.href}>{extra.label}</a></p>}
</aside>

<script>
    import '../scripts/copy';
</script>
