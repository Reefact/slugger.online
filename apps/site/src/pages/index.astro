---
import Base from '../layouts/Base.astro';
import ActOne from '../components/ActOne.astro';
import ActTwo from '../components/ActTwo.astro';
import ActThree from '../components/ActThree.astro';
import { themes } from '../catalogue';
import { narration } from '../narrative';

// Every slug on this page was drawn at build time by the real engine, from a fixed seed —
// §14.3. None is typed. If a theme stopped producing one, the build would fail rather than
// the page showing something the tool does not produce.
const hero = themes.themes[0];
---

<Base
    title="slugger — readable names from a vocabulary you own"
    description="A .NET command and library that draw adjective-noun names from JSON themes, and refuse a vocabulary that does not hold up."
    showHeaderInstall={false}
>
    <!--
      §9.8 — the hero. The main content is available without the .NET runtime, and the
      runtime is never loaded without an explicit act of the visitor's: this slug was drawn
      at build time by the same engine the playground runs, so there is only ever ONE
      producer of slugs (§9.8). Writing a generator in JavaScript would take a few lines and
      would respect neither categories, nor exclusions, nor a theme's style — which is
      precisely what the site exists to show.
    -->
    <section class="hero shell">
        <p class="slot-name">Drawn by the engine, at build time</p>
        <p class="slug">{hero.samples[0]}</p>
        <h1>You bring the words. slugger never draws a pair you didn&rsquo;t allow.</h1>
        <p class="prose">
            A .NET command and library that draw readable names from a vocabulary you write —
            and that refuse one which does not hold up.
        </p>
        <p class="prose">
            <a href="/playground/">Draw one yourself</a> &middot;
            <a href="/themes/">Themes already written</a>
        </p>
    </section>

    <!--
      §9.2 — ONE transformation in three acts, not a succession of independent slides. The
      visitor meets a limit, is handed the vocabulary, and is then shown what answers for it.
    -->
    <!-- Each act carries its own exit, so "every act ends with one" holds by
         construction rather than by how this page happens to be assembled (§9.3). -->
    <ActOne />
    <ActTwo />
    <ActThree />

    <section class="shell ruled closing">
        <p class="state">
            Every name on this page was drawn by the engine at build time, seed {narration.seed},
            from themes the library carries at <code class="mono">{narration.pinnedTag}</code>.
            Nothing here was typed by hand.
        </p>
    </section>
</Base>
