@inject HttpClient Http

@*
    THE WHOLE APPLICATION, with no router and no layout component — and that is a trimming
    decision as much as a simplicity one (§10.8).

    Blazor's <Router> and <LayoutView> resolve layouts and route components through
    reflection, which the trimmer cannot follow: they produce IL2110/IL2111 warnings that no
    change to this repository can fix, and §10.8 makes a trim warning an error in continuous
    integration. The playground has nothing to route — its state lives in the URL fragment
    (§10.7), and a theme the visitor opened is never addressable at all (§10.6) — so the
    router was cost without purpose.

    A client-side route added later brings the router back, and with it a line per route in
    apps/site/public/_redirects. Neither is needed while this is one page.
*@

<div class="shell">
    <header class="site-header">
        <a class="wordmark" href="/">slugger</a>
        <span class="slot-name">Playground</span>
    </header>

    <main id="main">
        <p class="slot-name">Drawn in your browser, by the engine itself</p>
        <p class="slug @Fitting" data-slug>@_slug</p>

        @*
            §5.7 — a refusal is said, never swallowed. The text is the engine's own: the site
            decides where it sits and nothing more (§10.4).
        *@
        @if (_refusal is not null)
        {
            <p class="refusal" role="status" data-refusal>@_refusal</p>
        }

        <div class="controls">
            <button type="button" @onclick="Draw" disabled="@(_chosen.Count == 0)">Draw another</button>
        </div>

        <section class="picker" aria-labelledby="themes-heading">
            <h2 class="slot-name" id="themes-heading">Themes</h2>
            <p class="prose">
                The catalogue's themes, at the tag this site was built from. Pick more than one
                and the engine draws from all of them at once, exactly as
                <code>--theme</code> repeated does.
            </p>

            <div class="choices">
                @foreach (CatalogueTheme theme in Available)
                {
                    <label class="choice">
                        <input type="checkbox"
                               checked="@_chosen.Contains(theme.Name)"
                               @onchange="@(e => ChooseTheme(theme.Name, e.Value is true))" />
                        <span>@theme.Name</span>
                    </label>
                }
            </div>
        </section>

        <section class="picker" aria-labelledby="options-heading">
            <h2 class="slot-name" id="options-heading">Options</h2>
            <p class="prose">
                The options the command line offers, and the same list (§10.5). An option is off
                until you turn it on, as a flag is until you type it; what it does is the
                command's own description of it.
            </p>

            @foreach (DrawOption option in _options)
            {
                bool on = _set.ContainsKey(option.Property);

                <div class="option">
                    <label class="choice">
                        <input type="checkbox"
                               checked="@on"
                               @onchange="@(e => Toggle(option, e.Value is true))" />
                        <code>@option.Template</code>
                    </label>

                    @if (on && option.Type is not "bool")
                    {
                        IReadOnlyList<string> values = DrawOptions.ValuesOf(option.Type);

                        @if (values.Count > 0)
                        {
                            <select value="@_set[option.Property]"
                                    @onchange="@(e => SetValue(option, e.Value?.ToString() ?? string.Empty))">
                                @foreach (string value in values)
                                {
                                    <option value="@value">@value</option>
                                }
                            </select>
                        }
                        else
                        {
                            <input type="@(option.Type.StartsWith("int", StringComparison.Ordinal) ? "number" : "text")"
                                   value="@_set[option.Property]"
                                   @onchange="@(e => SetValue(option, e.Value?.ToString() ?? string.Empty))" />
                        }
                    }

                    <p class="prose note">@option.Description</p>
                </div>
            }
        </section>

        @*
            §10.2's SECOND USE, and §4 calls its reader the best-served audience of this site. It
            takes from a theme's author the one step that forced them to install something before
            knowing whether their work held up.
        *@
        <section class="picker" aria-labelledby="yours-heading">
            <h2 class="slot-name" id="yours-heading">Your theme</h2>
            <p class="prose">
                Open a theme file, or paste one. It is read here, in this page: it is sent nowhere,
                saved nowhere, and known to nobody. There is no server to send it to. For the same
                reason a theme you opened cannot be shared by its address — sharing it would mean
                transmitting it.
            </p>

            <div class="controls">
                <label class="choice">
                    <InputFile OnChange="OpenFile" accept=".json,application/json" />
                </label>
            </div>

            <textarea class="theme-input" rows="6" spellcheck="false"
                      placeholder="{ &quot;nouns&quot;: [...], &quot;adjectives&quot;: [...] }"
                      @bind="_json" @bind:event="oninput"></textarea>

            @if (_waiver is not null)
            {
                <label class="choice">
                    <input type="checkbox" checked="@_waived" @onchange="@(e => Waive(e.Value is true))" />
                    <code>@_waiver.Template</code>
                </label>
                <p class="prose note">@_waiver.Description</p>
            }

            <div class="controls">
                <button type="button" @onclick="Measure" disabled="@string.IsNullOrWhiteSpace(_json)">
                    Measure this theme
                </button>
            </div>

            @if (_analysis is { } analysis)
            {
                <div class="report" data-report>
                    @*
                        The verdict, then the reasons, then the numbers. The order, the grouping and
                        what folds are this page's business; every sentence inside them is the
                        engine's, word for word (§10.4).
                    *@
                    <p class="verdict @(analysis.IsAccepted ? "verdict--accepted" : "verdict--refused")" data-verdict>
                        @if (analysis.IsAccepted)
                        {
                            @(analysis.FloorsWaived
                                ? $"\"{analysis.Name}\" is accepted with the size floors waived."
                                : $"\"{analysis.Name}\" is accepted as it is.")
                        }
                        else
                        {
                            @($"\"{analysis.Name}\" would be refused.")
                        }
                    </p>

                    @if (analysis.Refusals.Count > 0)
                    {
                        <ul class="reasons" data-reasons>
                            @foreach (SluggerThemeError refusal in analysis.Refusals)
                            {
                                <li>
                                    <code class="code">@refusal.Code</code>
                                    <span>@Reasons.Said(refusal.DiagnosticMessage)</span>
                                </li>
                            }
                        </ul>
                    }

                    @if (analysis.Remarks.Count > 0)
                    {
                        <ul class="reasons">
                            @foreach (string remark in analysis.Remarks)
                            {
                                <li><span>@Reasons.Said(remark)</span></li>
                            }
                        </ul>
                    }

                    @if (analysis.Measurements is { } measured)
                    {
                        @*
                            Measured even when the theme is refused, which is the case that matters:
                            an author wants to know by how much, not only that.
                        *@
                        <dl class="measured">
                            <dt>Combinations</dt>
                            <dd>@measured.Combinations.ToString("N0")</dd>

                            <dt>Longest slug</dt>
                            <dd><code>@measured.LongestSlug</code></dd>

                            <dt>Least exposed</dt>
                            <dd><code>@measured.LeastExposed.Word</code> — @measured.LeastExposed.Nouns nouns</dd>

                            <dt>Most exposed</dt>
                            <dd><code>@measured.MostExposed.Word</code> — @measured.MostExposed.Nouns nouns</dd>

                            @if (measured.DuplicatedNouns.Count > 0)
                            {
                                <dt>Duplicated nouns</dt>
                                <dd>@string.Join(", ", measured.DuplicatedNouns)</dd>
                            }

                            @if (measured.UnreachableCategories.Count > 0)
                            {
                                <dt>Unreachable categories</dt>
                                <dd>@string.Join(", ", measured.UnreachableCategories)</dd>
                            }
                        </dl>

                        @if (measured.Margins.Count > 0)
                        {
                            <table class="margins">
                                <thead>
                                    <tr><th scope="col">Rule</th><th scope="col">Worst case</th><th scope="col">Limit</th><th scope="col">Subject</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (ThemeMargin margin in measured.Margins)
                                    {
                                        <tr class="@(margin.WorstCase < margin.Limit ? "margin--under" : null)">
                                            <td>@margin.Rule</td>
                                            <td>@margin.WorstCase.ToString("N0")</td>
                                            <td>@margin.Limit.ToString("N0")</td>
                                            <td>@margin.Subject@(margin.Beside is null ? null : $" beside {margin.Beside}")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }
                    else
                    {
                        <p class="prose note">There is nothing to measure yet.</p>
                    }

                    @*
                        §10.2 makes this limit a thing to write rather than leave to be guessed. The
                        phases of the protocol that find the most are human readings, and none of
                        them automates.
                    *@
                    <p class="prose note">
                        This says whether the file holds together with what it declares. It does not
                        say whether the theme reads well — that is a reading, and nothing here
                        replaces it.
                    </p>
                </div>
            }
        </section>

        <p class="prose">
            @if (_combinations > 0)
            {
                <strong>@_combinations.ToString("N0")</strong>
                @: distinct names are reachable with these options.
            }
            Nothing you choose here leaves your browser, and there is no second generator: the
            engine on this page is the one the command runs.
        </p>
    </main>
</div>

@code {

    private readonly List<CatalogueTheme> _catalogue = [];
    private readonly List<DrawOption> _options = [];

    // The catalogue, and the one file the visitor opened. One at a time: an author is trying THEIR
    // theme, and a second slot would turn a workbench into a library.
    private IEnumerable<CatalogueTheme> Available => _opened is null ? _catalogue : _catalogue.Append(_opened);

    // The themes chosen, and the options turned on with the text their control holds. Absence is
    // how an option says "not given", which is what a command line means by not typing a flag.
    private readonly HashSet<string> _chosen = [];
    private readonly Dictionary<string, string> _set = [];

    // A theme is parsed once. A repository theme costs a fetch and a parse; neither belongs in a
    // redraw, which should be the engine's work and nothing else.
    private readonly Dictionary<string, SluggerTheme> _loaded = [];

    // A slug has no space in it, and an underscore gives a browser no place to break a line,
    // so a long one breaks mid-letter at a display size — the one thing a name must never do
    // to a reader. The size steps down with the length. It is layout and nothing else: the
    // text stays exactly what the engine drew (§14.3).
    private string _fileName = string.Empty;

    private string? Fitting => _slug.Length switch {
        > 34 => "slug--small",
        > 22 => "slug--medium",
        _    => null
    };

    // The file the visitor opened: its text, what it is called, what the engine made of it, and
    // whether the size floors were waived to judge it. None of it is sent anywhere — there is no
    // server to send it to (§10.6, §12.3), which makes the promise structural rather than stated.
    private string _json = string.Empty;
    private bool _waived;
    private ThemeWaiver? _waiver;
    private CatalogueTheme? _opened;
    private ThemeAnalysis? _analysis;

    private string _slug = string.Empty;
    private string? _refusal;
    private long _combinations;

    protected override async Task OnInitializedAsync() {
        try {
            CatalogueTheme[] themes = await Http.GetFromJsonAsync("themes/index.json", PlaygroundJson.Default.CatalogueThemeArray)
                                   ?? [];
            DrawOptionsFile? options = await Http.GetFromJsonAsync("options.json", PlaygroundJson.Default.DrawOptionsFile);

            _catalogue.AddRange(themes);
            _options.AddRange(options?.Options ?? []);
            _waiver = options?.Waiver;
        } catch (Exception failure) {
            _refusal = $"The catalogue did not load: {failure.Message}";

            return;
        }

        // The theme the command line draws from when none is named, so the page opens on what
        // `slugger` alone would have given.
        CatalogueTheme? first = _catalogue.FirstOrDefault(theme => theme.Name == "slugger") ?? _catalogue.FirstOrDefault();
        if (first is not null) {
            _chosen.Add(first.Name);
            await DrawAsync();
        }
    }

    private async Task ChooseTheme(string name, bool chosen) {
        if (chosen) { _chosen.Add(name); } else { _chosen.Remove(name); }

        await DrawAsync();
    }

    private async Task Toggle(DrawOption option, bool on) {
        if (on) {
            _set[option.Property] = DrawOptions.ValuesOf(option.Type) is [string first, ..] ? first : string.Empty;
        } else {
            _set.Remove(option.Property);
        }

        await DrawAsync();
    }

    private async Task SetValue(DrawOption option, string value) {
        _set[option.Property] = value;

        await DrawAsync();
    }

    private void Draw() {
        _ = DrawAsync();
    }

    /// <summary>Reads the file the visitor chose, and measures it at once.</summary>
    private async Task OpenFile(InputFileChangeEventArgs chosen) {
        IBrowserFile file = chosen.File;

        // A theme is words, not data: a megabyte is already far past any of them. The cap is what
        // keeps a mistaken file from filling the tab rather than a judgement about themes.
        using StreamReader reader = new(file.OpenReadStream(2 * 1024 * 1024));

        _json = await reader.ReadToEndAsync();
        _fileName = Path.GetFileNameWithoutExtension(file.Name);

        await MeasureAsync();
    }

    private async Task Waive(bool waived) {
        _waived = waived;

        if (_analysis is not null) { await MeasureAsync(); }
    }

    private void Measure() {
        _ = MeasureAsync();
    }

    /// <summary>
    ///     The second use of §10.2, in one call: the engine judges and measures the same text the
    ///     command would have judged, and never throws for the theme's sake. A theme that loads
    ///     joins the list above, so one just measured is drawn without leaving the page.
    /// </summary>
    private async Task MeasureAsync() {
        string name = string.IsNullOrWhiteSpace(_fileName) ? "your theme" : _fileName;

        _analysis = SluggerTheme.AnalyzeFromJson(_json, name, _waived);

        if (_opened is not null) {
            _chosen.Remove(_opened.Name);
            _loaded.Remove(_opened.Name);
        }

        _opened = null;

        Outcome<SluggerTheme> loaded = SluggerTheme.LoadFromJson(_json, name, _waived);
        if (loaded.Error is null) {
            _opened = new CatalogueTheme(name, "opened");
            _loaded[name] = loaded.GetResultOrThrow();
            _chosen.Add(name);
        }

        await DrawAsync();
    }

    private async Task DrawAsync() {
        // The slug is NOT blanked here. A redraw replaces one value with another, and an empty
        // frame between them is a flicker to a reader and nothing at all to a test reading the
        // moment after a click. It is cleared only where there is genuinely nothing to show.
        _refusal = null;

        if (_chosen.Count == 0) {
            _slug = string.Empty;
            _combinations = 0;
            _refusal = "Choose at least one theme.";
            StateHasChanged();

            return;
        }

        try {
            List<SluggerTheme> themes = [];
            foreach (string name in Available.Where(theme => _chosen.Contains(theme.Name)).Select(theme => theme.Name)) {
                themes.Add(await LoadAsync(name));
            }

            GenerationOptions options = GenerationOptions.Default;
            foreach ((string property, string value) in _set) {
                options = DrawOptions.Apply(options, property, value);
            }

            SlugGenerator generator = SlugGenerator.ForOrThrow(themes, _ => options);

            _combinations = generator.Combinations;
            _slug = generator.Next();
        } catch (Exception refused) {
            // The engine refuses a combination the controls can express — a segment mode a theme
            // cannot serve, a length no word fits under. Its own sentence says which, and it is
            // the sentence a reader would have got from the command (§10.4).
            _slug = string.Empty;
            _combinations = 0;
            _refusal = refused.Message;
        }

        StateHasChanged();
    }

    private async Task<SluggerTheme> LoadAsync(string name) {
        if (_loaded.TryGetValue(name, out SluggerTheme? already)) { return already; }

        CatalogueTheme entry = Available.First(theme => theme.Name == name);

        // An embedded theme travels inside the package; a repository one was published beside this
        // application by the build. Both end in the same call, which is the one the visitor's own
        // file will take in turn (§10.2).
        SluggerTheme theme = entry.Origin is "embedded"
            ? SluggerTheme.LoadEmbeddedOrThrow(name)
            : SluggerTheme.LoadFromJsonOrThrow(await Http.GetStringAsync($"themes/{name}.json"), name);

        _loaded[name] = theme;

        return theme;
    }

}
